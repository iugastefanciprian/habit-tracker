# MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name. Defaults to habit_tracker.
MONGODB_DB=habit_tracker

# Optional username for the local account created on first run.
# LOCAL_USERNAME=local

# Web Push / background reminders. Generate a key pair with:
#   npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address used by the push service. Use a mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for GET/POST /api/cron/reminders. Use a long random string.
CRON_SECRET=
